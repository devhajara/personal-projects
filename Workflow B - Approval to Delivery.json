    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nlet templateText = buffer.toString('utf-8');\n\nconst setNode = $('Edit Fields').item.json;\n\ntemplateText = templateText.replace(/\\(client name\\)/gi, setNode.clientName);\ntemplateText = templateText.replace(/\\(proposal link\\)/gi, `https://docs.google.com/document/d/${setNode.documentId}/edit`);\ntemplateText = templateText.replace(/\\(salesperson('|’)s name\\)/gi, setNode.salespersonName);\n\nreturn {\n  json: {\n    emailBody: templateText,\n    clientEmail: setNode.clientEmail,\n    companyName: setNode.companyName\n  }\n};"
      },
