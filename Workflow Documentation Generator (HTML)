      "parameters": {
        "jsCode": "const form = $('Documentation Form').first().json;\nconst pick = (keys) => {\n  for (const k of keys) {\n    const v = form[k];\n    if (typeof v === 'string' && v.trim()) return v.trim();\n  }\n  return '';\n};\nconst context = pick(['context', 'Context notes']);\nconst owner = pick(['owner', 'Owner']);\n\nconst item = $input.first();\nlet wf = item.json;\nif (Array.isArray(wf)) wf = wf[0];\nif (!wf || !Array.isArray(wf.nodes)) {\n  const bin = item.binary || {};\n  const key = Object.keys(bin)[0];\n  if (!key) throw new Error('Add a workflow link or ID, or upload the workflow JSON file.');\n  const buf = await this.helpers.getBinaryDataBuffer(0, key);\n  try {\n    wf = JSON.parse(buf.toString('utf8'));\n  } catch (e) {\n    throw new Error('The uploaded file is not valid JSON.');\n  }\n  if (Array.isArray(wf)) wf = wf[0];\n  if (wf && wf.workflow) wf = wf.workflow;\n}\nif (!wf || !Array.isArray(wf.nodes)) throw new Error('This does not look like an n8n workflow export.');\n\nconst SECRET_KEY = /(api[-_ ]?key|token|secret|password|passwd|authorization|private[-_ ]?key|access[-_ ]?key)/i;\nconst SECRET_VAL = /^(sk-|Bearer |Basic |xox[abp]-|ghp_|AIza|eyJ)/;\nconst clean = (value, key, depth) => {\n  if (depth > 8) return '[nested]';\n  if (typeof value === 'string') {\n    const isExpr = value.charAt(0) === '=' && value.indexOf('{{') > -1;\n    const rawValue = value.charAt(0) === '=' ? value.slice(1) : value;\n    if (!isExpr && ((key && SECRET_KEY.test(key)) || SECRET_VAL.test(rawValue))) return '[redacted]';\n    return value.length > 900 ? value.slice(0, 900) + ' ...[shortened]' : value;\n  }\n  if (Array.isArray(value)) return value.slice(0, 40).map((v) => clean(v, key, depth + 1));\n  if (value && typeof value === 'object') {\n    const result = {};\n    const named = typeof value.name === 'string' && SECRET_KEY.test(value.name);\n    for (const k of Object.keys(value)) {\n      const v = value[k];\n      if (named && k === 'value' && typeof v === 'string' && v.indexOf('{{') === -1) result[k] = '[redacted]';\n      else result[k] = clean(v, k, depth + 1);\n    }\n    return result;\n  }\n  return value;\n};\n\nconst short = (t) => String(t || '').replace('n8n-nodes-base.', '').replace('@n8n/n8n-nodes-langchain.', '');\nconst all = wf.nodes.filter((n) => n && n.name);\nconst stickyNotes = all\n  .filter((n) => short(n.type) === 'stickyNote')\n  .map((n) => String((n.parameters || {}).content || '').slice(0, 600))\n  .filter(Boolean);\nconst nodes = all\n  .filter((n) => short(n.type) !== 'stickyNote')\n  .map((n) => {\n    const pos = Array.isArray(n.position) ? n.position : null;\n    return {\n      name: n.name,\n      type: short(n.type),\n      disabled: n.disabled === true,\n      notes: n.notes || '',\n      credentialTypes: Object.keys(n.credentials || {}),\n      parameters: clean(n.parameters || {}, '', 0),\n      x: pos ? Number(pos[0]) : null,\n      y: pos ? Number(pos[1]) : null,\n    };\n  });\nif (nodes.every((n) => n.x !== null && n.y !== null)) nodes.sort((a, b) => a.x - b.x || a.y - b.y);\n\nconst connections = [];\nconst conn = wf.connections || {};\nfor (const from of Object.keys(conn)) {\n  for (const kind of Object.keys(conn[from] || {})) {\n    (conn[from][kind] || []).forEach((group, output) => {\n      (group || []).forEach((c) => {\n        if (c && c.node) connections.push({ from: from, to: c.node, kind: kind, output: output });\n      });\n    });\n  }\n}\nconst triggers = nodes.filter((n) => /trigger|webhook/i.test(n.type)).map((n) => n.name);\nconst workflowName = wf.name || 'Untitled workflow';\n\nconst forModel = {\n  workflowName: workflowName,\n  authorNotes: context || 'None provided',\n  stickyNotes: stickyNotes,\n  triggers: triggers,\n  nodes: nodes.map((n) => ({\n    name: n.name, type: n.type, disabled: n.disabled, notes: n.notes,\n    credentialTypes: n.credentialTypes, parameters: n.parameters,\n  })),\n  connections: connections,\n};\nlet workflowText = JSON.stringify(forModel);\nif (workflowText.length > 150000) {\n  forModel.nodes = forModel.nodes.map((n) => Object.assign({}, n, { parameters: JSON.stringify(n.parameters).slice(0, 350) }));\n  workflowText = JSON.stringify(forModel);\n}\n\nconst prompt = [\n  'You write documentation for n8n workflows. Readers are clients with no technical background, the workflow owner, and other developers.',\n  '',\n  'Rules:',\n  '1. Use only facts found in the workflow data and the author notes below. Never guess.',\n  '2. If something is not in the data, write exactly: Not specified',\n  '3. Plain, short sentences. No marketing language. No jargon in the client sections (summary, overview, how_it_works, needs, outputs).',\n  '4. Never include API keys, tokens or passwords.',\n  '5. Wrap node names, field names and expressions in backticks.',\n  '6. Return one JSON object only, with no text before or after it, in exactly this shape:',\n  '',\n  '{',\n  '  \"summary\": \"one sentence, at most 30 words, saying what the workflow does\",',\n  '  \"tags\": [\"apps or services it uses, at most 6\"],',\n  '  \"overview\": { \"problem\": \"the problem it solves, 1-2 sentences\", \"solution\": \"what the workflow does about it, 1-2 sentences\", \"result\": \"the end result in one sentence\" },',\n  '  \"how_it_works\": [\"5 to 8 plain-language steps in running order\"],',\n  '  \"needs\": [{ \"item\": \"account, credential or input\", \"why\": \"what it is used for\", \"required\": \"Yes or Optional\" }],',\n  '  \"outputs\": [\"each thing the workflow produces and where it ends up\"],',\n  '  \"outputs_note\": \"one practical thing to know about the output, or an empty string\",',\n  '  \"nodes\": [{ \"name\": \"exact node name\", \"purpose\": \"what this node does here\", \"settings\": \"the key settings that matter\" }],',\n  '  \"setup\": [\"steps to import and configure this workflow from scratch\"],',\n  '  \"values_to_change\": \"which values a new owner must change, in one sentence\",',\n  '  \"errors\": [{ \"situation\": \"what can go wrong\", \"result\": \"what the workflow does, based on its error settings\" }],',\n  '  \"limits\": \"known limits, in one sentence\",',\n  '  \"testing\": [\"steps to confirm it works\"],',\n  '  \"notes\": [\"assumptions or improvement ideas that the data supports\"]',\n  '}',\n  '',\n  'Include every node from the data in \"nodes\", using its exact name.',\n  '',\n  'Workflow data:',\n  workflowText,\n].join(String.fromCharCode(10));\n\nreturn [{ json: { workflowName, owner, triggers, nodes, connections, prompt } }];"
