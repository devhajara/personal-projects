      "parameters": {
        "jsCode": "const src = $('Clean Workflow').first().json;\nconst modelOut = $input.first().json;\nlet doc = modelOut.text !== undefined ? modelOut.text : modelOut;\nif (typeof doc === 'string') {\n  try {\n    doc = JSON.parse(doc.slice(doc.indexOf('{'), doc.lastIndexOf('}') + 1));\n  } catch (e) {\n    throw new Error('The AI did not return valid JSON. Run the workflow again or choose another model.');\n  }\n}\n\nconst NS = 'Not specified';\nconst BT = String.fromCharCode(96);\nconst codeRe = new RegExp(BT + '([^' + BT + ']+)' + BT, 'g');\nconst text = (x) => (typeof x === 'string' ? x : x && typeof x === 'object' ? Object.values(x).join(' - ') : x === undefined || x === null ? '' : String(x));\nconst esc = (s) => (String(s).trim() === '' ? NS : String(s)).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst rich = (x) => esc(text(x)).replace(codeRe, '<code>$1</code>');\nconst arr = (x) => (Array.isArray(x) ? x : x ? [x] : []).filter((v) => v !== null && v !== undefined && v !== '');\nconst TYPE_NAMES = { n8n: 'n8n', if: 'IF', httpRequest: 'HTTP Request', chainLlm: 'Basic LLM Chain', agent: 'AI Agent', set: 'Edit Fields', code: 'Code', form: 'Form page' };\nconst human = (t) => {\n  if (TYPE_NAMES[t]) return TYPE_NAMES[t];\n  const base = String(t).indexOf('lmChat') === 0 ? String(t).slice(6) + 'ChatModel' : String(t);\n  const s = base.replace(/([a-z0-9])([A-Z])/g, '$1 $2');\n  return s.charAt(0).toUpperCase() + s.slice(1);\n};\nconst cut = (s, n) => (s.length > n ? s.slice(0, n - 1) + '...' : s);\n\nconst p = (x) => '<p>' + rich(x) + '</p>';\nconst ul = (list) => (list.length ? '<ul class=\"plain\">' + list.map((x) => '<li>' + rich(x) + '</li>').join('') + '</ul>' : p(''));\nconst ol = (list) => (list.length ? '<ol class=\"steps\">' + list.map((x) => '<li><div>' + rich(x) + '</div></li>').join('') + '</ol>' : p(''));\nconst table = (heads, rows) =>\n  '<div class=\"table-wrap\"><table><thead><tr>' + heads.map((h) => '<th>' + h + '</th>').join('') + '</tr></thead><tbody>' +\n  (rows.length ? rows.map((r) => '<tr>' + r.map((c) => '<td>' + c + '</td>').join('') + '</tr>').join('') : '<tr><td colspan=\"' + heads.length + '\">' + NS + '</td></tr>') +\n  '</tbody></table></div>';\nconst callout = (kind, label, x) => (text(x).trim() ? '<div class=\"callout ' + kind + '\"><strong>' + label + '</strong>' + rich(x) + '</div>' : '');\nconst card = (part, id, num, title, body) =>\n  '<section class=\"card ' + part + '\" id=\"' + id + '\"><header><span class=\"num\">' + num + '</span><h2>' + title + '</h2></header><div class=\"body\">' + body + '</div></section>';\n\nconst nodes = src.nodes || [];\nconst index = {};\nnodes.forEach((n, i) => { index[n.name] = i; });\n\nlet map = '';\nif (nodes.length && nodes.every((n) => n.x !== null && n.y !== null)) {\n  const W = 164, H = 52, PAD = 14, GX = 34, GY = 30;\n  const rank = (vals, tol) => {\n    const starts = [];\n    Array.from(new Set(vals)).sort((p, q) => p - q).forEach((v) => {\n      if (!starts.length || v - starts[starts.length - 1] > tol) starts.push(v);\n    });\n    return { count: starts.length, of: (v) => starts.filter((g) => g <= v).length - 1 };\n  };\n  const cols = rank(nodes.map((n) => n.x), 60);\n  const rows = rank(nodes.map((n) => n.y), 40);\n  const tw = PAD * 2 + cols.count * W + (cols.count - 1) * GX;\n  const th = PAD * 2 + rows.count * H + (rows.count - 1) * GY;\n  const bx = (n) => PAD + cols.of(n.x) * (W + GX);\n  const by = (n) => PAD + rows.of(n.y) * (H + GY);\n  const edges = (src.connections || []).map((c) => {\n    const a = nodes[index[c.from]];\n    const b = nodes[index[c.to]];\n    if (!a || !b) return '';\n    if (c.kind === 'main') {\n      const sx = bx(a) + W, sy = by(a) + H / 2, tx = bx(b) - 5, ty = by(b) + H / 2;\n      return '<path class=\"edge\" marker-end=\"url(#arrow)\" d=\"M' + sx + ' ' + sy + ' C' + (sx + 16) + ' ' + sy + ' ' + (tx - 16) + ' ' + ty + ' ' + tx + ' ' + ty + '\"/>';\n    }\n    return '<path class=\"edge sub\" d=\"M' + (bx(a) + W / 2) + ' ' + by(a) + ' L' + (bx(b) + W / 2) + ' ' + (by(b) + H) + '\"/>';\n  }).join('');\n  const boxes = nodes.map((n, i) => {\n    const x = bx(n), y = by(n);\n    const trig = /trigger|webhook/i.test(n.type);\n    return '<g class=\"node' + (trig ? ' trig' : '') + (n.disabled ? ' off' : '') + '\"><rect x=\"' + x + '\" y=\"' + y + '\" width=\"' + W + '\" height=\"' + H + '\" rx=\"9\"/>' +\n      '<circle cx=\"' + (x + 20) + '\" cy=\"' + (y + H / 2) + '\" r=\"12\"/><text class=\"badge\" x=\"' + (x + 20) + '\" y=\"' + (y + H / 2 + 4) + '\" text-anchor=\"middle\">' + (i + 1) + '</text>' +\n      '<text class=\"nm\" x=\"' + (x + 40) + '\" y=\"' + (y + 22) + '\">' + esc(cut(n.name, 17)) + '</text>' +\n      '<text class=\"ty\" x=\"' + (x + 40) + '\" y=\"' + (y + 38) + '\">' + esc(cut(human(n.type), 21)) + '</text></g>';\n  }).join('');\n  map = '<div class=\"map-wrap\"><svg class=\"map\" viewBox=\"0 0 ' + tw + ' ' + th + '\" style=\"min-width:' + Math.round(tw * 0.85) + 'px;max-width:' + Math.round(tw * 1.1) + 'px\" role=\"img\" aria-label=\"Map of the workflow\">' +\n    '<defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" style=\"fill:var(--muted)\"/></marker></defs>' +\n    edges + boxes + '</svg></div><p class=\"caption\">Workflow map drawn from the canvas layout. Numbers match the node breakdown. Dashed lines are AI sub-nodes. Scroll sideways if it is cut off.</p>';\n}\n\nconst byName = {};\narr(doc.nodes).forEach((n) => { if (n && n.name) byName[String(n.name).trim().toLowerCase()] = n; });\nconst nodeRows = nodes.map((n, i) => {\n  const d = byName[n.name.trim().toLowerCase()] || {};\n  return ['<span class=\"n\">' + (i + 1) + '</span>', '<b>' + esc(n.name) + '</b><br><span class=\"type\">' + esc(human(n.type)) + (n.disabled ? ' (disabled)' : '') + '</span>', rich(d.purpose), rich(d.settings)];\n});\ncons