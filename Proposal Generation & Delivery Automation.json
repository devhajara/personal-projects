        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a proposal writer. Given raw sales call notes, expand them into polished, professional proposal copy. Return ONLY valid JSON with these exact keys: introduction, client_needs_summary, scope, approach, goals, deliverables, timeline, pricing, closing. The \\\"approach\\\" field should describe, in 2-3 sentences, the recommended methodology or approach for delivering the solution (distinct from \\\"scope,\\\" which describes what's being built). No markdown, no code fences, no preamble — just the raw JSON object.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Client: {{ $json['Client Name'] }} | Company: {{ $json['Company Name'] }} | Needs: {{ $json['Summary of Client\\'s Needs'] }}| Scope: {{ $json['Project Scope'] }} | Goals: {{ $json['Goals & Objectives'] }} | Services: {{ $json['Recommended Services/Deliverables'] }} | Timeline: {{ $json['Proposed Timeline'] }} | Pricing: {{ $json['Estimated Pricing'] }}\"\n    }\n  ],\n  \"temperature\": 0.5\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "aa4d6089-27d7-4f72-af0c-ca6adcf9d25a",
