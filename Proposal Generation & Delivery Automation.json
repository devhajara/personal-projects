      "credentials": {
        "httpHeaderAuth": {
          "id": "oYbrdXOzqCge7GQU",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices[0].message.content;\n\nlet parsed;\ntry {\n  // Strip any accidental markdown fences or stray text before/after the JSON\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(jsonMatch[0]);\n} catch (e) {\n  throw new Error(\"Failed to parse AI JSON output: \" + e.message + \" | Raw: \" + raw);\n}\n\n// Pull the original form fields back in from the trigger node\nconst form = $('Google Sheets Trigger').item.json;\n\nreturn {\n  json: {\n    clientName: form['Client Name'],\n    clientEmail: form['Client Email'],\n    companyName: form['Company Name'],\n   dateOfCall: DateTime.fromFormat(form['Date of Call'], 'dd/MM/yyyy').toISODate(),\n    salespersonName: form['Salesperson Name'],\n    needsSummary: form[\"Summary of Client's Needs\"],\n    projectScope: form['Project Scope'],\n    goals: form['Goals & Objectives'],\n    services: form['Recommended Services/Deliverables'],\n    timeline: form['Proposed Timeline'],\n    pricing: form['Estimated Pricing'],\n    introduction: parsed.introduction,\n    client_needs_summary: parsed.client_needs_summary,\n    scope: parsed.scope,\n    approach: parsed.approach,\n    goals_ai: parsed.goals,\n    deliverables: parsed.deliverables,\n    timeline_ai: parsed.timeline,\n    pricing_ai: parsed.pricing,\n    closing: parsed.closing,\n    aiDraftFull: JSON.stringify(parsed, null, 2)\n  }\n};"
      },
